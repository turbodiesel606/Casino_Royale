{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "JOBTRACKER_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JOBTRACKER_ENABLE_DEB_PACKAGING": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-debug"
    },
    {
      "name": "linux-debug-tests",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-debug-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JOBTRACKER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-relwithdebinfo",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-deb-local-test",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-deb-local-test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JOBTRACKER_BUILD_TESTS": "OFF",
        "JOBTRACKER_ENABLE_DEB_PACKAGING": "ON",
        "JOBTRACKER_DEB_LOCAL_TEST": "ON"
      }
    },
    {
      "name": "linux-deb-release",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-deb-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JOBTRACKER_BUILD_TESTS": "OFF",
        "JOBTRACKER_ENABLE_DEB_PACKAGING": "ON",
        "JOBTRACKER_DEB_LOCAL_TEST": "OFF"
      }
    },
    {
      "name": "linux-release-tests",
      "inherits": "linux-release",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/linux-release-tests",
      "cacheVariables": {
        "JOBTRACKER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/windows-debug"
    },
    {
      "name": "windows-debug-tests",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/windows-debug-tests",
      "cacheVariables": {
        "JOBTRACKER_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/windows-release"
    },
    {
      "name": "windows-release-tests",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/qt-6.10.3/windows-release-tests",
      "cacheVariables": {
        "JOBTRACKER_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-debug-tests",
      "configurePreset": "linux-debug-tests"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-relwithdebinfo",
      "configurePreset": "linux-relwithdebinfo"
    },
    {
      "name": "linux-deb-local-test",
      "configurePreset": "linux-deb-local-test"
    },
    {
      "name": "linux-deb-release",
      "configurePreset": "linux-deb-release"
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-release-tests"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-debug-tests",
      "configurePreset": "windows-debug-tests",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-release-tests",
      "configurePreset": "windows-release-tests",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug-tests",
      "configurePreset": "linux-debug-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-release-tests",
      "configurePreset": "linux-release-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-debug-tests",
      "configurePreset": "windows-debug-tests",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-release-tests",
      "configurePreset": "windows-release-tests",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
