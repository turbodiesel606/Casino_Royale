cmake_minimum_required(VERSION 3.22)

# CPack 3.28 adds --ignore-missing-info internally. Independently scan every
# shipped ELF without that flag; map only the libraries bundled in this DEB.
set(stage "${CPACK_TEMPORARY_DIRECTORY}")
set(check_dir "$ENV{JOBTRACKER_DEB_WORK}/dependency-check")
file(MAKE_DIRECTORY "${stage}/DEBIAN" "${check_dir}/debian")
file(WRITE "${check_dir}/stage-root.txt" "${stage}\n")
message(STATUS "Package stage: ${stage}")
file(WRITE "${check_dir}/debian/control"
    "Source: jobtracker\n\nPackage: jobtracker\nArchitecture: amd64\nDescription: JobTracker private runtime\n")
file(GLOB private_libraries "${stage}/opt/jobtracker/lib/*")
set(private_shlibs "")
foreach(path IN LISTS private_libraries)
    if(IS_SYMLINK "${path}")
        continue()
    endif()
    execute_process(COMMAND "@JOBTRACKER_READELF_EXECUTABLE@" -d "${path}"
        OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
    if(NOT dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
        message(FATAL_ERROR "Missing SONAME in bundled library: ${path}")
    endif()
    set(soname "${CMAKE_MATCH_1}")
    if(NOT soname MATCHES "^(lib(Qt6|icu)[A-Za-z0-9_]+)\\.so\\.([0-9]+)$")
        message(FATAL_ERROR "Review the dependency policy for bundled library: ${soname}")
    endif()
    string(APPEND private_shlibs "${CMAKE_MATCH_1} ${CMAKE_MATCH_3} jobtracker\n")
endforeach()
file(WRITE "${check_dir}/debian/shlibs.local" "${private_shlibs}")

file(GLOB_RECURSE payload_files LIST_DIRECTORIES FALSE "${stage}/*")
set(elf_files "")
foreach(path IN LISTS payload_files)
    if(NOT IS_SYMLINK "${path}")
        file(READ "${path}" magic LIMIT 4 HEX)
        if(magic STREQUAL "7f454c46")
            list(APPEND elf_files "${path}")
        endif()
    endif()
endforeach()
if(NOT elf_files)
    message(FATAL_ERROR "No ELF objects found in the package stage.")
endif()
execute_process(COMMAND "@JOBTRACKER_SHLIBDEPS_EXECUTABLE@" -O -xjobtracker ${elf_files}
    WORKING_DIRECTORY "${check_dir}"
    RESULT_VARIABLE scan_result OUTPUT_VARIABLE scan_output ERROR_VARIABLE scan_error)
file(WRITE "${check_dir}/dpkg-shlibdeps.log" "${scan_output}\n${scan_error}")
file(WRITE "${check_dir}/elf-files.txt" "${elf_files}\n")
if(NOT scan_result EQUAL 0 OR NOT scan_output MATCHES "^shlibs:Depends=([^\n]+)")
    message(FATAL_ERROR "Strict dpkg-shlibdeps failed (${scan_result}): ${scan_error}")
endif()
file(WRITE "${check_dir}/system-depends.txt" "${CMAKE_MATCH_1}")
list(LENGTH elf_files elf_count)
message(STATUS "Strict dependency scan passed for ${elf_count} shipped ELF objects")
