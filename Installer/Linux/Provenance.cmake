cmake_minimum_required(VERSION 3.22)

# Standalone package evidence. No Git, source timestamps, or environment dump.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)

function(json_string value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(input_manifest output)
    set(paths CMakeLists.txt CMakePresets.json)
    foreach(directory IN ITEMS src qml cmake Installer)
        if(IS_SYMLINK "${root}/${directory}")
            message(FATAL_ERROR "Source input symlinks are not supported: ${directory}")
        endif()
        file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/${directory}/*")
        list(APPEND paths ${entries})
    endforeach()
    list(SORT paths)
    set(manifest "")
    foreach(path IN LISTS paths)
        if(path MATCHES "(^|/)(build|output|cache|logs|\\.git|__pycache__)(/|$)"
                OR path MATCHES "Create-Installer\\.local\\."
                OR path MATCHES "\\.(log|pyc)$")
            continue()
        endif()
        if(IS_SYMLINK "${root}/${path}")
            message(FATAL_ERROR "Source input symlinks are not supported: ${path}")
        endif()
        if(IS_DIRECTORY "${root}/${path}")
            continue()
        endif()
        if(path MATCHES "[\r\n;]")
            message(FATAL_ERROR "Unsupported input filename: ${path}")
        endif()
        file(SHA256 "${root}/${path}" hash)
        string(APPEND manifest "${hash}  ${path}\n")
    endforeach()
    set(${output} "${manifest}" PARENT_SCOPE)
endfunction()

function(write_new path contents)
    if(EXISTS "${path}")
        message(FATAL_ERROR "Evidence already exists; use a fresh run: ${path}")
    endif()
    file(WRITE "${path}" "${contents}")
endfunction()

function(local_settings output)
    set(settings "{}")
    foreach(key IN ITEMS user_presets launcher_config)
        if(key STREQUAL "user_presets")
            set(path "${root}/CMakeUserPresets.json")
        else()
            set(path "${LOCAL_CONFIG}")
        endif()
        set(hash absent)
        if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
            file(SHA256 "${path}" hash)
        endif()
        string(JSON settings SET "${settings}" "${key}" "\"${hash}\"")
    endforeach()
    set(${output} "${settings}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "manifest")
    input_manifest(manifest)
    write_new("${OUTPUT}" "${manifest}")
    return()
endif()
if(MODE STREQUAL "settings")
    local_settings(settings)
    string(JSON actual GET "${settings}" launcher_config)
    if(DEFINED SOURCE_CONFIG_HASH AND NOT SOURCE_CONFIG_HASH STREQUAL actual)
        message(FATAL_ERROR "Local configuration changed after it was sourced")
    endif()
    write_new("${OUTPUT}" "${settings}")
    return()
endif()

if(MODE STREQUAL "capture")
    input_manifest(manifest)
    if(DEFINED SOURCE_MANIFEST AND NOT SOURCE_MANIFEST STREQUAL "")
        file(READ "${SOURCE_MANIFEST}" expected)
        if(NOT expected STREQUAL manifest)
            message(FATAL_ERROR "Source inputs changed during the launcher run; rebuild in a new run")
        endif()
    endif()
    write_new("${WORK}/input-manifest.sha256" "${manifest}")
    string(SHA256 digest "${manifest}")
    set(snapshot "{\"schema\":1}")
    foreach(key IN ITEMS digest root BUILD)
        json_string("${${key}}" value)
        string(JSON snapshot SET "${snapshot}" "${key}" "${value}")
    endforeach()
    set(configure_preset "")
    set(build_preset "")
    if(DEFINED LAUNCHER_RECORD AND NOT LAUNCHER_RECORD STREQUAL "")
        file(STRINGS "${LAUNCHER_RECORD}" lines ENCODING UTF-8)
        foreach(line IN LISTS lines)
            if(line MATCHES "^preset=(.*)$")
                set(configure_preset "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^buildPreset=(.*)$")
                set(build_preset "${CMAKE_MATCH_1}")
            elseif(line MATCHES "^build=(.*)$")
                set(record_build "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        if(NOT record_build STREQUAL BUILD OR configure_preset STREQUAL "")
            message(FATAL_ERROR "Launcher record does not identify this build")
        endif()
    endif()
    foreach(key IN ITEMS configure_preset build_preset TIMESTAMPED)
        json_string("${${key}}" value)
        string(JSON snapshot SET "${snapshot}" "${key}" "${value}")
    endforeach()
    string(JSON snapshot SET "${snapshot}" configuration "\"Release\"")
    string(JSON snapshot SET "${snapshot}" generator "\"DEB\"")
    string(JSON snapshot SET "${snapshot}" source_observation "\"package preflight; clean Ninja dry run required\"")
    file(STRINGS "${BUILD}/CMakeCache.txt" lines ENCODING UTF-8)
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^/#][^:]*):[^=]+=(.*)$")
            set(cache_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        endif()
    endforeach()
    set(cache "{}")
    foreach(key IN ITEMS CMAKE_BUILD_TYPE CMAKE_GENERATOR CMAKE_CXX_COMPILER
            CMAKE_INSTALL_PREFIX CMAKE_INSTALL_BINDIR
            CMAKE_INSTALL_LIBDIR CMAKE_PREFIX_PATH Qt6_DIR JOBTRACKER_BUILD_TESTS
            JOBTRACKER_ENABLE_DEB_PACKAGING JOBTRACKER_DEB_LOCAL_TEST
            JOBTRACKER_DEB_REVISION JOBTRACKER_DEB_MAINTAINER)
        json_string("${cache_${key}}" value)
        string(JSON cache SET "${cache}" "${key}" "${value}")
    endforeach()
    # Compiler flags can contain credentials in definitions; retain hashes only.
    foreach(key IN ITEMS CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_RELEASE CMAKE_EXE_LINKER_FLAGS
            CMAKE_EXE_LINKER_FLAGS_RELEASE CMAKE_CXX_COMPILER_LAUNCHER)
        string(SHA256 hash "${cache_${key}}")
        string(JSON cache SET "${cache}" "${key}_sha256" "\"${hash}\"")
    endforeach()
    string(JSON snapshot SET "${snapshot}" cache "${cache}")
    file(SHA256 "${BUILD}/CMakeCache.txt" cache_hash)
    string(JSON snapshot SET "${snapshot}" cache_sha256 "\"${cache_hash}\"")
    set(cmake_version "${cache_CMAKE_CACHE_MAJOR_VERSION}.${cache_CMAKE_CACHE_MINOR_VERSION}.${cache_CMAKE_CACHE_PATCH_VERSION}")
    file(READ "${BUILD}/CMakeFiles/${cmake_version}/CMakeCXXCompiler.cmake" compiler_info)
    set(compiler "{}")
    foreach(key IN ITEMS CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION)
        string(REGEX MATCH "set\\(${key} \"([^\"]+)\"\\)" found "${compiler_info}")
        if(NOT found)
            message(FATAL_ERROR "Missing compiler identity: ${key}")
        endif()
        json_string("${CMAKE_MATCH_1}" value)
        string(JSON compiler SET "${compiler}" "${key}" "${value}")
    endforeach()
    string(JSON snapshot SET "${snapshot}" compiler "${compiler}")
    string(JSON snapshot SET "${snapshot}" configure_cmake_version "\"${cmake_version}\"")
    string(JSON snapshot SET "${snapshot}" cmake_version "\"${CMAKE_VERSION}\"")
    find_program(cpack_program cpack REQUIRED)
    execute_process(COMMAND "${cpack_program}" --version OUTPUT_VARIABLE cpack_version
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    json_string("${cpack_version}" value)
    string(JSON snapshot SET "${snapshot}" cpack_version "${value}")
    json_string("${cpack_program}" value)
    string(JSON snapshot SET "${snapshot}" cpack_path "${value}")
    get_filename_component(kit "${cache_Qt6_DIR}/../../.." REALPATH)
    if(CMAKE_HOST_WIN32)
        set(qmake "${kit}/bin/qmake.exe")
    else()
        set(qmake "${kit}/bin/qmake")
    endif()
    execute_process(COMMAND "${qmake}" -query QT_VERSION OUTPUT_VARIABLE qt_version
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    json_string("${qt_version}" value)
    string(JSON snapshot SET "${snapshot}" qt_version "${value}")
    json_string("${kit}" value)
    string(JSON snapshot SET "${snapshot}" qt_kit "${value}")
    local_settings(settings)
    if(DEFINED SETTINGS_MANIFEST AND NOT SETTINGS_MANIFEST STREQUAL "")
        file(READ "${SETTINGS_MANIFEST}" expected_settings)
        if(NOT settings STREQUAL expected_settings)
            message(FATAL_ERROR "Local/preset settings changed during the launcher run")
        endif()
    endif()
    string(JSON snapshot SET "${snapshot}" local_settings_sha256 "${settings}")
    # Exact built executable and generated inputs consumed by CPack, not caches/logs.
    file(GLOB_RECURSE generated LIST_DIRECTORIES FALSE RELATIVE "${BUILD}"
        "${BUILD}/Installer/Linux/*.cmake" "${BUILD}/.qt/*.cmake")
    list(APPEND generated JobTrackerApp CPackConfig.cmake cmake_install.cmake build.ninja)
    list(SORT generated)
    set(built_inputs "{}")
    foreach(path IN LISTS generated)
        file(SHA256 "${BUILD}/${path}" hash)
        string(JSON built_inputs SET "${built_inputs}" "${path}" "\"${hash}\"")
    endforeach()
    string(JSON snapshot SET "${snapshot}" built_inputs_sha256 "${built_inputs}")
    write_new("${WORK}/inputs.json" "${snapshot}\n")
elseif(MODE STREQUAL "seal")
    file(READ "${WORK}/inputs.json" snapshot)
    local_settings(settings)
    string(JSON expected_settings GET "${snapshot}" local_settings_sha256)
    if(NOT settings STREQUAL expected_settings)
        message(FATAL_ERROR "Local/preset settings changed while packaging")
    endif()
    file(READ "${WORK}/input-manifest.sha256" original_manifest)
    input_manifest(current_manifest)
    if(NOT current_manifest STREQUAL original_manifest)
        message(FATAL_ERROR "Source inputs changed while packaging; no success receipt")
    endif()
    file(SHA256 "${BUILD}/CMakeCache.txt" cache_hash)
    string(JSON expected_cache_hash GET "${snapshot}" cache_sha256)
    if(NOT cache_hash STREQUAL expected_cache_hash)
        message(FATAL_ERROR "Build cache changed while packaging; no success receipt")
    endif()
    string(JSON count LENGTH "${snapshot}" built_inputs_sha256)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON path MEMBER "${snapshot}" built_inputs_sha256 ${index})
        string(JSON expected GET "${snapshot}" built_inputs_sha256 "${path}")
        file(SHA256 "${BUILD}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Build input changed while packaging: ${path}")
        endif()
    endforeach()
    # Seal private bytes before publication while recording their final destination.
    # Direct helper callers may still seal an already published package.
    if(NOT DEFINED PACKAGE_CANDIDATE OR PACKAGE_CANDIDATE STREQUAL "")
        set(PACKAGE_CANDIDATE "${PACKAGE}")
    endif()
    file(SHA256 "${PACKAGE_CANDIDATE}" package_hash)
    file(SIZE "${PACKAGE_CANDIDATE}" package_size)
    file(SHA256 "${WORK}/inputs.json" inputs_hash)
    file(SHA256 "${WORK}/input-manifest.sha256" manifest_hash)
    set(receipt "{\"schema\":1}")
    foreach(key IN ITEMS PACKAGE PACKAGE_VERSION package_hash package_size inputs_hash manifest_hash)
        json_string("${${key}}" value)
        string(JSON receipt SET "${receipt}" "${key}" "${value}")
    endforeach()
    string(JSON receipt SET "${receipt}" inputs "\"inputs.json\"")
    string(JSON receipt SET "${receipt}" manifest "\"input-manifest.sha256\"")
    write_new("${WORK}/provenance.json" "${receipt}\n")
elseif(MODE STREQUAL "verify")
    file(READ "${WORK}/provenance.json" receipt)
    foreach(key IN ITEMS PACKAGE PACKAGE_VERSION package_hash package_size)
        string(JSON recorded GET "${receipt}" "${key}")
        if(NOT recorded STREQUAL "${${key}}")
            message(FATAL_ERROR "Provenance/package mismatch: ${key}")
        endif()
    endforeach()
    foreach(pair IN ITEMS "inputs;inputs.json;inputs_hash" "manifest;input-manifest.sha256;manifest_hash")
        list(GET pair 0 key)
        list(GET pair 1 name)
        list(GET pair 2 hash_key)
        string(JSON recorded_name GET "${receipt}" "${key}")
        string(JSON expected GET "${receipt}" "${hash_key}")
        file(SHA256 "${WORK}/${name}" actual)
        if(NOT recorded_name STREQUAL name OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "Provenance evidence mismatch: ${name}")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "Use MODE=manifest, settings, capture, seal or verify")
endif()
