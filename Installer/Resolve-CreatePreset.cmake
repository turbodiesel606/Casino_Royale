cmake_minimum_required(VERSION 3.22)

# Read the existing native Release preset contract without configuring a cache.
# Inputs are process-local environment variables; output is a UTF-8 key=value
# record, never shell code. CMake remains responsible for executing the preset.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${root}/CMakeLists.txt" project)
string(REGEX MATCH "project\\(JobTracker[ \r\n]+VERSION[ \r\n]+([0-9]+\\.[0-9]+\\.[0-9]+)" match "${project}")
if(NOT match)
    message(FATAL_ERROR "Cannot read project(JobTracker VERSION ...) from root CMakeLists.txt.")
endif()
set(version "${CMAKE_MATCH_1}")
string(REGEX MATCH "set\\(JOBTRACKER_QT_VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)\\)" match "${project}")
set(qt_version "${CMAKE_MATCH_1}")

foreach(file IN ITEMS CMakePresets.json CMakeUserPresets.json)
    if(NOT EXISTS "${root}/${file}")
        continue()
    endif()
    file(READ "${root}/${file}" json)
    # These launchers follow the repository's schema-3 local preset convention.
    # Refuse constructs we cannot inspect rather than configure an unknown tree.
    string(JSON includes ERROR_VARIABLE error GET "${json}" include)
    if(NOT error)
        message(FATAL_ERROR "Installer preset inspection supports self-contained presets (no include). Use a local preset in CMakeUserPresets.json inheriting the shared Release preset.")
    endif()
    foreach(kind IN ITEMS configure build)
        string(JSON count ERROR_VARIABLE error LENGTH "${json}" ${kind}Presets)
        if(error OR count EQUAL 0)
            continue()
        endif()
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON preset GET "${json}" ${kind}Presets ${i})
            string(JSON name GET "${preset}" name)
            if(DEFINED ${kind}_${name})
                message(FATAL_ERROR "Duplicate ${kind} preset: ${name}")
            endif()
            set(${kind}_${name} "${preset}")
            string(JSON environment ERROR_VARIABLE error GET "${preset}" environment)
            if(NOT error AND kind STREQUAL "configure")
                string(JSON count_env LENGTH "${environment}")
                if(count_env GREATER 0)
                    math(EXPR last_env "${count_env} - 1")
                    foreach(j RANGE 0 ${last_env})
                        string(JSON key MEMBER "${environment}" ${j})
                        list(APPEND environment_keys "${key}")
                    endforeach()
                endif()
            endif()
        endforeach()
    endforeach()
endforeach()
set(preset_kind configure)

# First parent wins, matching CMake's inheritance precedence, including per-key
# cache/environment inheritance. Detect cycles before invoking real configure.
function(lookup name output)
    if(NOT DEFINED ${preset_kind}_${name} OR name IN_LIST visiting)
        message(FATAL_ERROR "Unknown or cyclic configure preset: ${name}")
    endif()
    list(APPEND visiting "${name}")
    string(JSON value ERROR_VARIABLE error GET "${${preset_kind}_${name}}" ${ARGN})
    if(NOT error)
        string(JSON type TYPE "${${preset_kind}_${name}}" ${ARGN})
        if(type STREQUAL "OBJECT" AND ARGV2 STREQUAL "cacheVariables")
            string(JSON value GET "${value}" value)
        endif()
        set(${output} "${value}" PARENT_SCOPE)
        set(${output}_type "${type}" PARENT_SCOPE)
        return()
    endif()
    string(JSON parents ERROR_VARIABLE error GET "${${preset_kind}_${name}}" inherits)
    if(NOT error)
        string(JSON type TYPE "${${preset_kind}_${name}}" inherits)
        if(type STREQUAL "ARRAY")
            string(JSON count LENGTH "${parents}")
            set(parent_list "")
            if(count GREATER 0)
                math(EXPR last "${count} - 1")
                foreach(i RANGE 0 ${last})
                    string(JSON parent GET "${parents}" ${i})
                    list(APPEND parent_list "${parent}")
                endforeach()
            endif()
        else()
            set(parent_list "${parents}")
        endif()
        foreach(parent IN LISTS parent_list)
            lookup("${parent}" inherited ${ARGN})
            if(DEFINED inherited)
                set(${output} "${inherited}" PARENT_SCOPE)
                set(${output}_type "${inherited_type}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endif()
    unset(${output} PARENT_SCOPE)
    unset(${output}_type PARENT_SCOPE)
endfunction()

function(expand input output)
    set(value "${input}")
    get_filename_component(parent "${root}" DIRECTORY)
    get_filename_component(leaf "${root}" NAME)
    # Environment values may refer to other inherited preset environment keys.
    foreach(pass RANGE 1 20)
        string(REPLACE "\${sourceDir}" "${root}" value "${value}")
        string(REPLACE "\${sourceParentDir}" "${parent}" value "${value}")
        string(REPLACE "\${sourceDirName}" "${leaf}" value "${value}")
        string(REPLACE "\${presetName}" "${selected}" value "${value}")
        string(REPLACE "\${hostSystemName}" "${CMAKE_HOST_SYSTEM_NAME}" value "${value}")
        if(NOT value MATCHES "\\$(p?env)\\{([^}]+)\\}")
            break()
        endif()
        set(token "${CMAKE_MATCH_0}")
        set(kind "${CMAKE_MATCH_1}")
        set(key "${CMAKE_MATCH_2}")
        unset(replacement)
        if(kind STREQUAL "env")
            lookup("${selected}" replacement environment "${key}")
        endif()
        if(NOT DEFINED replacement)
            set(replacement "$ENV{${key}}")
        endif()
        string(REPLACE "${token}" "${replacement}" value "${value}")
    endforeach()
    if(value MATCHES "\\$[A-Za-z]*\\{")
        message(FATAL_ERROR "Unsupported or cyclic preset macro: ${value}")
    endif()
    if(value MATCHES "[\r\n]" OR (value MATCHES ";" AND NOT ARGV2 STREQUAL "environment"))
        message(FATAL_ERROR "Installer settings must be single values without newlines or semicolons: ${value}")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

if(CMAKE_HOST_WIN32)
    set(base windows-release)
    set(expected_generator "Visual Studio 17 2022")
    set(qmake_name qmake.exe)
    set(expected_spec win32-msvc)
else()
    set(base linux-deb-release)
    set(expected_generator Ninja)
    set(qmake_name qmake)
    set(expected_spec linux-g++)
endif()
set(selected "$ENV{JOBTRACKER_CREATE_PRESET}")
set(qt "$ENV{JOBTRACKER_CREATE_QT}")
if(selected STREQUAL "")
    set(selected "${base}-local")
    set(local_compatible FALSE)
    if(DEFINED configure_${selected} AND qt STREQUAL "")
        lookup("${selected}" prefix cacheVariables CMAKE_PREFIX_PATH)
        expand("${prefix}" prefix)
        execute_process(COMMAND "${prefix}/bin/${qmake_name}" -query QT_VERSION
            RESULT_VARIABLE probe_status OUTPUT_VARIABLE probe_version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        execute_process(COMMAND "${prefix}/bin/${qmake_name}" -query QMAKE_XSPEC
            RESULT_VARIABLE probe_spec_status OUTPUT_VARIABLE probe_spec OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(probe_status EQUAL 0 AND probe_version STREQUAL qt_version AND probe_spec_status EQUAL 0 AND probe_spec STREQUAL expected_spec)
            set(local_compatible TRUE)
        endif()
    endif()
    if(NOT DEFINED configure_${selected} OR (qt STREQUAL "" AND NOT local_compatible))
        set(selected "${base}")
    endif()
endif()
if(NOT DEFINED configure_${selected})
    message(FATAL_ERROR "Configure preset '${selected}' does not exist. Set the preset in the local Create-Installer configuration or use ${base} with a Qt kit.")
endif()
# Verify descent from the dedicated production preset, without depending on its
# directory name or accidentally reusing an ordinary/test/local-test tree.
set(marker __jobtracker_create_base)
string(JSON configure_${base} SET "${configure_${base}}" "${marker}" "true")
lookup("${selected}" descended "${marker}")
if(NOT descended)
    message(FATAL_ERROR "Installer configure preset must inherit ${base}: ${selected}")
endif()
lookup("${selected}" generator generator)
if(NOT generator STREQUAL expected_generator)
    message(FATAL_ERROR "Installer requires ${expected_generator}: ${selected}")
endif()
lookup("${selected}" tests cacheVariables JOBTRACKER_BUILD_TESTS)
lookup("${selected}" toolchain toolchainFile)
lookup("${selected}" cache_toolchain cacheVariables CMAKE_TOOLCHAIN_FILE)
lookup("${selected}" environment_toolchain environment CMAKE_TOOLCHAIN_FILE)
if(NOT DEFINED environment_toolchain)
    set(environment_toolchain "$ENV{CMAKE_TOOLCHAIN_FILE}")
endif()
if(tests OR toolchain OR cache_toolchain OR environment_toolchain)
    message(FATAL_ERROR "Installer requires a native production preset with tests OFF and no toolchain file.")
endif()
if(NOT CMAKE_HOST_WIN32)
    lookup("${selected}" type cacheVariables CMAKE_BUILD_TYPE)
    lookup("${selected}" deb cacheVariables JOBTRACKER_ENABLE_DEB_PACKAGING)
    lookup("${selected}" local_test cacheVariables JOBTRACKER_DEB_LOCAL_TEST)
    if(NOT type STREQUAL "Release" OR NOT deb OR local_test)
        message(FATAL_ERROR "Installer requires Release, DEB ON, tests OFF, and JOBTRACKER_DEB_LOCAL_TEST=OFF.")
    endif()
else()
    lookup("${selected}" arch architecture value)
    if(NOT DEFINED arch)
        lookup("${selected}" arch architecture)
    endif()
    if(NOT arch STREQUAL "x64")
        message(FATAL_ERROR "Installer requires the x64 architecture.")
    endif()
endif()
lookup("${selected}" binary binaryDir)
expand("${binary}" binary)
get_filename_component(binary "${binary}" ABSOLUTE BASE_DIR "${root}")
file(TO_CMAKE_PATH "${binary}" binary)
string(FIND "${binary}/" "${root}/build/" build_prefix)
if(NOT build_prefix EQUAL 0)
    message(FATAL_ERROR "Installer build directory must be below this checkout's build/: ${binary}")
endif()
if(qt STREQUAL "")
    lookup("${selected}" qt cacheVariables CMAKE_PREFIX_PATH)
    expand("${qt}" qt)
endif()
if(qt STREQUAL "" OR NOT IS_DIRECTORY "${qt}/lib/cmake/Qt6")
    message(FATAL_ERROR "Missing Qt SDK. Configure QtRoot/INSTALLER_QT_ROOT once in the local Create-Installer configuration, select an installed local preset, or set QTDIR. See Installer/README.md.")
endif()
file(REAL_PATH "${qt}" qt BASE_DIRECTORY "${root}")
execute_process(COMMAND "${qt}/bin/${qmake_name}" -query QT_VERSION
    RESULT_VARIABLE status OUTPUT_VARIABLE actual_qt OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND "${qt}/bin/${qmake_name}" -query QMAKE_XSPEC
    RESULT_VARIABLE spec_status OUTPUT_VARIABLE spec OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT status EQUAL 0 OR NOT actual_qt STREQUAL qt_version OR NOT spec_status EQUAL 0 OR NOT spec STREQUAL expected_spec)
    message(FATAL_ERROR "Selected Qt SDK must be Qt ${qt_version} ${expected_spec}: ${qt}")
endif()
lookup("${selected}" preset_qt cacheVariables Qt6_DIR)
if(preset_qt)
    expand("${preset_qt}" preset_qt)
    file(REAL_PATH "${preset_qt}/../../.." preset_qt)
    if(NOT preset_qt STREQUAL qt)
        message(FATAL_ERROR "Preset Qt6_DIR conflicts with the selected Qt SDK: ${preset_qt}; ${qt}")
    endif()
endif()
set(maintainer "$ENV{JOBTRACKER_CREATE_MAINTAINER}")
if(NOT CMAKE_HOST_WIN32)
    if(maintainer STREQUAL "")
        lookup("${selected}" maintainer cacheVariables JOBTRACKER_DEB_MAINTAINER)
        expand("${maintainer}" maintainer)
    endif()
    if(maintainer STREQUAL "")
        set(maintainer "$ENV{JOBTRACKER_DEB_MAINTAINER}")
    endif()
    if(NOT maintainer MATCHES "^[^<>;\n\r]+ <[^<> ;\n\r]+@[^<> ;\n\r]+>$"
            OR maintainer MATCHES "[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr]|[<]local-test@|@invalid[>]|example\\.(com|org|net)[>]")
        message(FATAL_ERROR "Configure a real release maintainer once: INSTALLER_MAINTAINER='Name <email>' in Create-Installer.local.conf, a release preset's JOBTRACKER_DEB_MAINTAINER, or the environment. Placeholder/local-test metadata is not accepted.")
    endif()
endif()

# Preserve incompatible caches. Never ask configure to switch an existing SDK,
# source root, generator, compiler, test role, or packaging role in place.
if(EXISTS "${binary}/CMakeCache.txt")
    file(STRINGS "${binary}/CMakeCache.txt" lines ENCODING UTF-8)
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^/#][^:]*):[^=]+=(.*)$")
            set(cache_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
        endif()
    endforeach()
    # Visual Studio records the compiler in CMake's language information rather
    # than necessarily adding CMAKE_CXX_COMPILER to CMakeCache.txt.
    foreach(language IN ITEMS CXX C)
        set(info "${binary}/CMakeFiles/${cache_CMAKE_CACHE_MAJOR_VERSION}.${cache_CMAKE_CACHE_MINOR_VERSION}.${cache_CMAKE_CACHE_PATCH_VERSION}/CMake${language}Compiler.cmake")
        if(EXISTS "${info}" AND NOT DEFINED cache_CMAKE_${language}_COMPILER)
            file(STRINGS "${info}" compiler_line ENCODING UTF-8 REGEX "^set\\(CMAKE_${language}_COMPILER \"")
            if(compiler_line MATCHES "^set\\(CMAKE_${language}_COMPILER \"([^\"]+)\"\\)")
                set(cache_CMAKE_${language}_COMPILER "${CMAKE_MATCH_1}")
            endif()
        endif()
    endforeach()
    set(conflict "")
    if(NOT cache_CMAKE_HOME_DIRECTORY STREQUAL root OR NOT cache_CMAKE_GENERATOR STREQUAL generator
            OR cache_JOBTRACKER_BUILD_TESTS OR cache_CMAKE_TOOLCHAIN_FILE)
        set(conflict "source/generator/tests/toolchain")
    endif()
    if(CMAKE_HOST_WIN32)
        if(NOT cache_CMAKE_GENERATOR_PLATFORM STREQUAL "x64")
            set(conflict "architecture")
        endif()
    elseif(NOT cache_CMAKE_BUILD_TYPE STREQUAL "Release" OR NOT cache_JOBTRACKER_ENABLE_DEB_PACKAGING
            OR cache_JOBTRACKER_DEB_LOCAL_TEST)
        set(conflict "Release DEB configuration")
    endif()
    foreach(line IN LISTS lines)
        if(line MATCHES "^(Qt6[^:]*_DIR):[^=]+=(.*)$")
            set(cached_qt "${CMAKE_MATCH_2}")
            file(TO_CMAKE_PATH "${cached_qt}" cached_qt)
            string(FIND "${cached_qt}/" "${qt}/" qt_prefix)
            if(NOT cached_qt STREQUAL "" AND NOT cached_qt MATCHES "-NOTFOUND$" AND NOT qt_prefix EQUAL 0)
                set(conflict "cached Qt component ${CMAKE_MATCH_1}: ${cached_qt}")
            endif()
        endif()
    endforeach()
    foreach(key IN ITEMS CMAKE_GENERATOR_INSTANCE CMAKE_CXX_COMPILER CMAKE_C_COMPILER)
        lookup("${selected}" requested cacheVariables "${key}")
        if(NOT requested AND NOT key STREQUAL "CMAKE_GENERATOR_INSTANCE")
            if(key STREQUAL "CMAKE_CXX_COMPILER")
                set(environment_key CXX)
            else()
                set(environment_key CC)
            endif()
            lookup("${selected}" requested environment "${environment_key}")
            if(NOT DEFINED requested)
                set(requested "$ENV{${environment_key}}")
            endif()
        endif()
        if(requested AND (key STREQUAL "CMAKE_GENERATOR_INSTANCE" OR DEFINED cache_${key}))
            expand("${requested}" requested)
            if(NOT key STREQUAL "CMAKE_GENERATOR_INSTANCE")
                set(saved_path "$ENV{PATH}")
                lookup("${selected}" requested_path environment PATH)
                if(DEFINED requested_path)
                    expand("${requested_path}" requested_path environment)
                    set(ENV{PATH} "${requested_path}")
                endif()
                unset(compiler_path)
                find_program(compiler_path NAMES "${requested}" NO_CACHE)
                set(ENV{PATH} "${saved_path}")
                if(compiler_path)
                    file(REAL_PATH "${compiler_path}" requested)
                endif()
            endif()
            file(TO_CMAKE_PATH "${requested}" requested)
            set(cached "${cache_${key}}")
            if(NOT key STREQUAL "CMAKE_GENERATOR_INSTANCE" AND EXISTS "${cached}")
                file(REAL_PATH "${cached}" cached)
            endif()
            if(NOT requested STREQUAL cached)
                set(conflict "${key}")
            endif()
        endif()
    endforeach()
    lookup("${selected}" toolset toolset value)
    if(NOT DEFINED toolset)
        lookup("${selected}" toolset toolset)
    endif()
    if(toolset AND NOT toolset STREQUAL cache_CMAKE_GENERATOR_TOOLSET)
        set(conflict "MSVC toolset")
    endif()
    if(conflict)
        message(FATAL_ERROR "Incompatible cache (${conflict}): ${binary}. Preserved without reconfiguration. Select a local preset with a fresh binaryDir under build/, or restore the matching SDK/settings. Nothing is deleted.")
    endif()
endif()
set(build_preset "")
if(DEFINED build_${selected})
    set(preset_kind build)
    lookup("${selected}" paired configurePreset)
    lookup("${selected}" configuration configuration)
    if(NOT paired STREQUAL selected OR (CMAKE_HOST_WIN32 AND NOT configuration STREQUAL "Release"))
        message(FATAL_ERROR "Build preset '${selected}' must refer to the selected configure preset and Release configuration.")
    endif()
    set(build_preset "${selected}")
    set(preset_kind configure)
endif()
file(WRITE "$ENV{JOBTRACKER_CREATE_RESULT}"
    "preset=${selected}\nbuildPreset=${build_preset}\nbuild=${binary}\nqt=${qt}\nversion=${version}\nmaintainer=${maintainer}\n")
if(environment_keys)
    list(REMOVE_DUPLICATES environment_keys)
    foreach(key IN LISTS environment_keys)
        lookup("${selected}" value environment "${key}")
        if(DEFINED value)
            if(value_type STREQUAL "NULL")
                file(APPEND "$ENV{JOBTRACKER_CREATE_RESULT}" "unset.${key}=\n")
            else()
                expand("${value}" value environment)
                file(APPEND "$ENV{JOBTRACKER_CREATE_RESULT}" "env.${key}=${value}\n")
            endif()
        endif()
    endforeach()
endif()
