; Generated identity hooks for the later Inno Setup script; not a standalone installer.
#define JobTrackerProductName "@PROJECT_NAME@"
#define JobTrackerReleaseVersion "@PROJECT_VERSION@"
#define JobTrackerWindowsVersion "@JOBTRACKER_WINDOWS_VERSION@"
#define JobTrackerPublisher ""
#define JobTrackerExecutableName "$<TARGET_FILE_NAME:JobTrackerApp>"
; [Setup] SetupIconFile
#define JobTrackerSetupIconFile "@JOBTRACKER_WINDOWS_ICON@"
; [Icons] IconFilename and IconIndex (both shortcut types)
#define JobTrackerShortcutIconFilename "{app}\bin\$<TARGET_FILE_NAME:JobTrackerApp>"
#define JobTrackerShortcutIconIndex 0
; [Setup] UninstallDisplayIcon
#define JobTrackerUninstallDisplayIcon "{app}\bin\$<TARGET_FILE_NAME:JobTrackerApp>,0"
