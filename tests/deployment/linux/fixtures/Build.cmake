file(APPEND "${ROOT}/trace.txt" "build\n")
if("$ENV{FIXTURE_FAIL}" STREQUAL "build")
    message(FATAL_ERROR "Intentional fixture build failure")
endif()
file(WRITE "${BUILD}/build-environment.txt" "")
foreach(key IN ITEMS FIXTURE_PARENT FIXTURE_NESTED FIXTURE_UNSET FIXTURE_BUILD)
    file(APPEND "${BUILD}/build-environment.txt" "${key}=$ENV{${key}}\n")
endforeach()
if(DEFINED ENV{FIXTURE_UNSET})
    file(APPEND "${BUILD}/build-environment.txt" "FIXTURE_UNSET_DEFINED=1\n")
else()
    file(APPEND "${BUILD}/build-environment.txt" "FIXTURE_UNSET_DEFINED=0\n")
endif()
file(WRITE "${BUILD}/app-ready" "Built fixture\n")
if("$ENV{FIXTURE_MUTATE_STAGE}" STREQUAL "build")
    file(APPEND "$ENV{FIXTURE_MUTATE_PATH}" "\n ")
endif()
