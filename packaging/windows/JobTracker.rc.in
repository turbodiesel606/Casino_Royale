#include <winver.h>

// The first icon group is also the shortcut/uninstall executable icon (index 0).
1 ICON "@JOBTRACKER_WINDOWS_ICON@"

1 VERSIONINFO
 FILEVERSION @JOBTRACKER_WINDOWS_VERSION_TUPLE@
 PRODUCTVERSION @JOBTRACKER_WINDOWS_VERSION_TUPLE@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS $<IF:$<CONFIG:Debug>,VS_FF_DEBUG,0x0L>
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "\0"
            VALUE "FileDescription", "JobTracker - job application tracker\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "$<TARGET_FILE_BASE_NAME:JobTrackerApp>\0"
            VALUE "OriginalFilename", "$<TARGET_FILE_NAME:JobTrackerApp>\0"
            VALUE "ProductName", "@PROJECT_NAME@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "LegalCopyright", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
